{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "alexic.ca" }],
      "destination": "https://www.alexic.ca/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/team.html", "destination": "/about-aic.html", "permanent": true }
  ],
  "headers": [
    { "source": "/docs/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/tests/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/scripts/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
